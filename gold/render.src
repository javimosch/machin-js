func escapeHtml(s) (r) {
    return replace(replace(replace(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
}

func renderLine(t) (r) {
    mark := "[ ]"
    if t.done == 1 { mark = "[x]" }
    return mark + " " + str(t.id) + " " + t.title
}

func renderButton(action, label) (r) {
    return "<form method=\"post\" action=\"" + action + "\"><button>" + label + "</button></form>"
}

func renderItem(t) (r) {
    cls := "open"
    if t.done == 1 { cls = "done" }
    toggle := renderButton("/toggle/" + str(t.id), escapeHtml(t.title))
    return "<li class=\"" + cls + "\">" + toggle + renderButton("/delete/" + str(t.id), "x") + "</li>"
}

func renderPage(todos) (r) {
    form := "<form method=\"post\" action=\"/add\"><input name=\"title\" placeholder=\"what needs doing?\"><button>add</button></form>"
    items := ""
    i := 0
    while i < len(todos) {
        items = items + renderItem(todos[i])
    i = i + 1
    }
    return "<!doctype html><title>todos</title><h1>todos</h1>" + form + "<ul>" + items + "</ul>"
}
